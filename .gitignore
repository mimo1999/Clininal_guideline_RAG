.env
__pycache__/
*.pyc
.venv/
webapp_out.txt

# data_corpus: only chroma_db.zip and pdf/ are shipped -- everything else is
# either regenerated by setup.py (processed/, vector_store/chroma/,
# vector_store/bm25.pkl) or local-only working state (cache/, progress/,
# the pre-swap embedder backup).
data_corpus/processed/
data_corpus/cache/
data_corpus/progress/
data_corpus/vector_store/chroma/
data_corpus/vector_store/chroma_bge-m3_backup/
data_corpus/vector_store/bm25.pkl
data_corpus/eval_retrieval_cache.json
data_corpus/eval_results*_full.json

# Only README.md is shipped -- every other markdown file (design logs,
# results docs, parsed-PDF sidecars) is excluded from the release.
*.md
!README.md
